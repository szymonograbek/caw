{
  "name": "omen-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev:setup": "sh scripts/dev-setup.sh",
    "build": "bun build --compile --minify --sourcemap packages/cli/src/main.ts --outfile dist/omen",
    "install:global": "bun run build && sh scripts/install-global.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/sdk && tsc --noEmit -p packages/core && tsc --noEmit -p packages/cli && tsc --noEmit -p plugins/discord && tsc --noEmit -p plugins/claude && tsc --noEmit -p plugins/memory && tsc --noEmit -p plugins/scheduler && tsc --noEmit -p plugins/profiles && tsc --noEmit -p tools/oxlint",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "bun --bun vitest run --project=omen && vitest run --project=oxlint",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@oxlint/plugins": "1.94.0",
    "@typeonce/oxlint-plugin-effect-machine": "0.46.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "knip": "6.46.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
